# --- Domains ---
# Used server-side to distinguish the two sites when NEXT_PUBLIC_FORCE_SITE isn't set.
NEXT_PUBLIC_JOIN_DOMAIN=joinvivra.com

# --- Lead storage (pick one; every lead is also emailed to francisco@ithaka.vc via
# FormSubmit.co regardless — free, no account needed, already active with none of
# these set) ---
# Recommended: Supabase (free tier, GDPR-ready, exportable, has a UI + can grow into a full CRM).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Table expected: leads (see README "Forms & CRM").

# Fallback / simplest option: Formspree. If set, form submissions POST here instead of Supabase.
FORMSPREE_JOIN_ENDPOINT=
FORMSPREE_IBIZA_ENDPOINT=
FORMSPREE_ALLIANCE_ENDPOINT=

# --- Notifications ---
# Optional: any webhook (Zapier, Make, Slack incoming webhook) to ping the team on new applications.
LEAD_NOTIFY_WEBHOOK_URL=

# Optional: Resend (https://resend.com) for branded confirmation emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL="VIVRA <hello@worldvivra.com>"

# --- /admin lead viewer ---
ADMIN_ACCESS_KEY=change-me

# --- Analytics ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Community ---
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
